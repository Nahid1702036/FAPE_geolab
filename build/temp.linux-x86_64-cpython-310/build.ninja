ninja_required_version = 1.3
cxx = /home/nahid/miniconda3/envs/nerf-lab/bin/x86_64-conda-linux-gnu-c++
nvcc = /home/nahid/miniconda3/envs/nerf-lab/bin/nvcc

cflags = -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem /home/nahid/miniconda3/envs/nerf-lab/include -DNDEBUG -D_FORTIFY_SOURCE=2 -O2 -isystem /home/nahid/miniconda3/envs/nerf-lab/include -fPIC -I/home/nahid/fape_geolab/csrc -I/home/nahid/miniconda3/envs/nerf-lab/lib/python3.10/site-packages/torch/include -I/home/nahid/miniconda3/envs/nerf-lab/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/nahid/miniconda3/envs/nerf-lab/lib/python3.10/site-packages/torch/include/TH -I/home/nahid/miniconda3/envs/nerf-lab/lib/python3.10/site-packages/torch/include/THC -I/home/nahid/miniconda3/envs/nerf-lab/include -I/home/nahid/miniconda3/envs/nerf-lab/include/python3.10 -c
post_cflags = -O3 -std=c++17 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0
cuda_cflags = -I/home/nahid/fape_geolab/csrc -I/home/nahid/miniconda3/envs/nerf-lab/lib/python3.10/site-packages/torch/include -I/home/nahid/miniconda3/envs/nerf-lab/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/nahid/miniconda3/envs/nerf-lab/lib/python3.10/site-packages/torch/include/TH -I/home/nahid/miniconda3/envs/nerf-lab/lib/python3.10/site-packages/torch/include/THC -I/home/nahid/miniconda3/envs/nerf-lab/include -I/home/nahid/miniconda3/envs/nerf-lab/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 --use_fast_math -gencode=arch=compute_70,code=sm_70 -gencode=arch=compute_80,code=sm_80 -gencode=arch=compute_86,code=sm_86 -gencode=arch=compute_89,code=sm_89 -gencode=arch=compute_90,code=sm_90 --expt-relaxed-constexpr --extended-lambda -DCUDA_HAS_FP16=1 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -ccbin /home/nahid/miniconda3/envs/nerf-lab/bin/x86_64-conda-linux-gnu-cc -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /home/nahid/fape_geolab/build/temp.linux-x86_64-cpython-310/csrc/cuda/fape_surgical_kernel.o: cuda_compile /home/nahid/fape_geolab/csrc/cuda/fape_surgical_kernel.cu
build /home/nahid/fape_geolab/build/temp.linux-x86_64-cpython-310/csrc/fape_pytorch_bridge.o: compile /home/nahid/fape_geolab/csrc/fape_pytorch_bridge.cpp






